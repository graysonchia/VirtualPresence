APP_NAME=VirtualPresence API
APP_ENV=development
APP_DEBUG=true
DATABASE_URL=postgresql+asyncpg://postgres:rodolfo@localhost:5432/virtualpresence
DATABASE_URL_SYNC=postgresql+psycopg://postgres:rodolfo@localhost:5432/virtualpresence
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
FRONTEND_ORIGINS=["http://localhost:5173"]
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
LLM_MOCK_MODE=true
LLM_MAX_TOKENS=500
CONVERSATION_CONTEXT_MESSAGES=20
CONVERSATION_RECOGNITION_TTL_SECONDS=300
STT_MODEL_SIZE=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_BEAM_SIZE=3
MAX_AUDIO_UPLOAD_BYTES=26214400
TTS_DEFAULT_VOICE=en-US-AriaNeural
TTS_MANDARIN_VOICE=zh-CN-XiaoxiaoNeural
TTS_MAX_TEXT_CHARACTERS=5000
FACE_MATCH_THRESHOLD=0.363
FACE_DETECTION_THRESHOLD=0.9
LIVENESS_THRESHOLD=0.70
MAX_UPLOAD_BYTES=10485760
